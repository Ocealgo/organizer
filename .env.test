# End-to-end runs only. No secrets here by design.
#
# The 'demo-' project id prefix is load-bearing: the Firebase SDKs refuse to
# talk to real infrastructure for a demo project, so even a misconfigured run
# cannot reach live data. The api key is a placeholder the emulator ignores.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-ocealgo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-ocealgo
VITE_FIREBASE_STORAGE_BUCKET=demo-ocealgo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demoapp
VITE_USE_EMULATORS=true
