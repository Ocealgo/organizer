{
  "name": "ocealgo-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "emulators": "firebase emulators:start --only firestore,auth",
    "test:rules": "firebase emulators:exec --only firestore --project demo-ocealgo \"node --test\"",
    "backend:deploy:dev": "firebase deploy --only firestore,storage --project dev",
    "backend:deploy:prod": "firebase deploy --only firestore,storage --project prod",
    "rules:deploy:dev": "firebase deploy --only firestore:rules --project dev",
    "rules:deploy:prod": "firebase deploy --only firestore:rules --project prod",
    "storage:deploy:dev": "firebase deploy --only storage --project dev",
    "storage:deploy:prod": "firebase deploy --only storage --project prod",
    "cap:sync": "npm run build && npx cap sync",
    "android": "npm run build && npx cap sync android && npx cap open android",
    "e2e:server": "firebase emulators:exec --only auth,firestore,storage,functions --project demo-ocealgo \"vite --mode test --port 5173 --host 127.0.0.1 --strictPort\"",
    "e2e": "playwright test --project=desktop --project=mobile",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "e2e:desktop": "playwright test --project=desktop",
    "e2e:mobile": "playwright test --project=mobile",
    "walkthroughs": "playwright test --project=walkthrough",
    "walkthroughs:cards": "playwright test --project=walkthrough cards.spec.ts",
    "walkthroughs:sting": "node scripts/make-sting.mjs",
    "walkthroughs:narrate": "node scripts/narrate.mjs",
    "walkthroughs:film": "node scripts/stitch-walkthroughs.mjs"
  },
  "dependencies": {
    "@capacitor/camera": "^8.2.2",
    "@capacitor/core": "^8.5.0",
    "@capacitor/device": "^8.0.3",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/local-notifications": "^8.3.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@types/leaflet": "^1.9.22",
    "firebase": "^10.7.0",
    "leaflet": "^1.9.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.0",
    "recharts": "^3.10.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@firebase/rules-unit-testing": "^3.0.4",
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^15.24.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  }
}
