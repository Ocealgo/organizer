rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Ocealgo Team Dashboard — Firestore security rules
//
// DESIGN PRINCIPLE
//   Writes are locked down; reads stay as permissive as the current UI needs.
//   Every screen today subscribes to whole collections (`onSnapshot(collection(...))`)
//   and filters client-side, so tightening reads requires UI changes first —
//   see "READ SCOPING" notes below. Writes are where the real damage lives
//   (privilege escalation, unauthorised money movement), so that is what this
//   pass closes.
//
// KNOWN GAPS — deliberate, marked inline as [GAP n]. Read these before deploying.
//
// PERFORMANCE NOTE
//   approved()/isAdmin() each do a get() on users/{uid}, which is a billed read
//   per rule evaluation. Once Cloud Functions exist, move role/status onto custom
//   auth claims and read request.auth.token.role instead — free and faster.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Identity helpers ────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Any user whose account has been approved by an admin.
    function approved() {
      return userExists() && userData().status == 'approved';
    }

    function isAdmin() {
      return approved() && userData().role in ['admin', 'super_admin'];
    }

    function isSuperAdmin() {
      return approved() && userData().role == 'super_admin';
    }

    function isSales() {
      return approved() && userData().role in ['offline_sales', 'online_sales'];
    }

    function isMarketing() {
      return approved() && userData().role in ['offline_marketing', 'online_marketing'];
    }

    // ── Field-diff helpers ──────────────────────────────────────────────────
    // NOTE: affectedKeys() reports TOP-LEVEL keys only. An update to
    // `productStock.abc.locked` shows up as `productStock`. That limitation is
    // the root of [GAP 2].
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function onlyChanged(fields) {
      return changedKeys().hasOnly(fields);
    }

    function isUnchanged(field) {
      return !changedKeys().hasAny([field]);
    }

    // ── USERS ───────────────────────────────────────────────────────────────
    // The single most important block in this file: it is what stops any
    // logged-in employee from making themselves super_admin.
    match /users/{uid} {

      // Own doc always readable (AuthContext needs it even while pending).
      // Approved users may read the roster — AdminDashboard and VisitLogger
      // both list sales users.
      allow read: if isSelf(uid) || approved();

      // Signup. Self only, always pending, never a privileged role, and the
      // email must match the verified auth token so it cannot be spoofed.
      //
      // This intentionally BLOCKS the hardcoded super-admin grant in
      // SignupPage.tsx:33-39. Bootstrapping a super_admin is a one-time manual
      // action in the Firebase console, not something a client may self-assign.
      allow create: if isSelf(uid)
        && request.resource.data.status == 'pending'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in [
             'offline_sales', 'online_sales',
             'offline_marketing', 'online_marketing'
           ];

      // Self-service: display name only. Never role, never status.
      allow update: if isSelf(uid) && onlyChanged(['name']);

      // Admin: approve / reject / deactivate / change role.
      //   · a super_admin's doc is untouchable by anyone (matches the UI rule)
      //   · only a super_admin may grant super_admin
      allow update: if isAdmin()
        && resource.data.role != 'super_admin'
        && onlyChanged(['role', 'status', 'approvedAt', 'approvedBy', 'approvedByName'])
        && (request.resource.data.role != 'super_admin' || isSuperAdmin());

      // Danger Zone clears users except super admins.
      allow delete: if isSuperAdmin() && resource.data.role != 'super_admin';
    }

    // ── PARTIES ─────────────────────────────────────────────────────────────
    match /parties/{partyId} {
      allow read: if approved();

      // Reps add prospects from PartyManager / VisitLogger. New parties must
      // start as prospects and be attributed to the actual author.
      allow create: if approved()
        && request.resource.data.status == 'prospect'
        && request.resource.data.addedBy == request.auth.uid;

      // Reps legitimately update parties: status → active on order, stock.*
      // on a revisit stock update, and inline field edits.
      allow update: if approved();

      // Only admins delete (matches PartyManager's admin-gated delete button).
      allow delete: if isAdmin();
    }

    // ── PRODUCTS ────────────────────────────────────────────────────────────
    // [GAP 1] seedDefaultProducts() in App.tsx:16 runs on EVERY app load for
    // EVERY role and will now fail for non-admins with a permission error.
    // Fix in code: gate the seed behind isAdmin, or drop it entirely.
    match /products/{productId} {
      allow read: if approved();
      allow write: if isAdmin();
    }

    // ── CONFIG ──────────────────────────────────────────────────────────────
    match /config/settings {
      allow read: if approved();
      allow write: if isSuperAdmin();   // Settings screen is super-admin only
    }

    match /config/stock {
      allow read: if approved();
      allow write: if isAdmin();

      // [GAP 2] Reps create allocations, and creating one locks company stock
      // (AllocationManager.tsx:218). So reps must be able to write
      // productStock.*.locked. Because affectedKeys() only sees top-level keys,
      // this also lets a rep alter productStock.*.total — rules cannot express
      // a nested-key restriction.
      //   Residual risk: a rep could inflate company stock totals.
      //   Proper fix: move stock locking into a Cloud Function, then delete
      //   this rule so config/stock becomes admin-write-only.
      // At least carton size and the legacy global pool are protected here.
      allow update: if isSales() && onlyChanged(['productStock', 'updatedAt']);
    }

    // ── ALLOCATIONS (allocations_v2) — the money collection ─────────────────
    match /allocations_v2/{allocId} {
      allow read: if approved();

      // Created by reps (VisitLogger, RevisitLogger) and admins. Must start
      // pending, be correctly attributed, carry no pre-set payment, and have
      // internally consistent arithmetic (±1 tolerance for float prices).
      allow create: if approved()
        && request.resource.data.status == 'pending'
        && request.resource.data.createdBy == request.auth.uid
        && !('paidAmount' in request.resource.data)
        && !('paidAt' in request.resource.data)
        && !('sentAt' in request.resource.data)
        && request.resource.data.packets > 0
        && request.resource.data.totalAmount >=
             request.resource.data.packets * request.resource.data.pricePerPacket - 1
        && request.resource.data.totalAmount <=
             request.resource.data.packets * request.resource.data.pricePerPacket + 1;

      // Admins: dispatch, mark paid, edit, cancel.
      allow update: if isAdmin();

      // Non-admins: may edit or cancel their OWN still-pending allocation.
      // May never dispatch, mark paid, or move money.
      allow update: if approved()
        && resource.data.createdBy == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status in ['pending', 'cancelled']
        && isUnchanged('createdBy')
        && isUnchanged('paidAmount')
        && isUnchanged('sentAt')
        && isUnchanged('paidAt');

      // [GAP 3] COMPATIBILITY RULE — REMOVE WHEN PAYMENTS MOVE SERVER-SIDE.
      //
      // RevisitLogger.tsx:469-484 has reps apply collected payments FIFO,
      // writing paidAmount (and status → 'paid') directly onto SENT
      // allocations. That is a rep writing to the financial ledger.
      //
      // This rule is enabled so that deploying these rules does not break a
      // live feature your team uses daily. It is the largest remaining hole.
      // Once the payment application is a callable Cloud Function, delete this
      // block — the strict rules above are already correct without it.
      allow update: if isSales()
        && resource.data.status in ['sent', 'overdue']
        && resource.data.paymentType == 'credit'
        && onlyChanged(['paidAmount', 'status', 'paidAt'])
        && request.resource.data.status in ['sent', 'overdue', 'paid'];

      allow delete: if isAdmin();
    }

    // ── PAYMENT TRANSACTIONS ────────────────────────────────────────────────
    match /payment_transactions/{txnId} {
      allow read: if approved();

      // A rep may log a collection, but only as pending_approval and only in
      // their own name. Pre-approving your own payment is denied.
      allow create: if approved()
        && request.resource.data.amount > 0
        && (
             isAdmin()
             || (request.resource.data.status == 'pending_approval'
                 && request.resource.data.collectedBy == request.auth.uid
                 && !('confirmedAt' in request.resource.data))
           );

      // Approve / reject / confirm receipt / edit amount — admin only.
      allow update: if isAdmin();

      // Reps delete their own not-yet-confirmed txn during the revisit-edit
      // and visit-delete flows.
      allow delete: if isAdmin()
        || (approved()
            && resource.data.collectedBy == request.auth.uid
            && !('confirmedAt' in resource.data));
    }

    // ── VISIT LOGS ──────────────────────────────────────────────────────────
    match /visit_logs/{logId} {
      allow read: if isAdmin()
        || resource.data.salesPersonId == request.auth.uid
        || request.auth.uid in resource.data.get('sharedWith', []);

      allow create: if approved()
        && request.resource.data.salesPersonId == request.auth.uid;

      // Owner, an existing share partner, or someone accepting a share request
      // (that write adds their own uid to sharedWith via arrayUnion).
      allow update: if isAdmin()
        || resource.data.salesPersonId == request.auth.uid
        || request.auth.uid in resource.data.get('sharedWith', [])
        || request.auth.uid in request.resource.data.get('sharedWith', []);

      allow delete: if isAdmin()
        || resource.data.salesPersonId == request.auth.uid;
    }

    // ── REVISIT LOGS ────────────────────────────────────────────────────────
    // READ SCOPING: VisitLogger queries `salesPersonId in [self, ...partners]`,
    // which a self-only rule cannot satisfy. Left readable to approved users
    // until visibility is driven by an explicit shared-with field on the doc.
    match /revisit_logs/{id} {
      allow read: if approved();
      allow create: if approved()
        && request.resource.data.salesPersonId == request.auth.uid;
      allow update, delete: if isAdmin()
        || resource.data.salesPersonId == request.auth.uid;
    }

    // ── VISIT SHARE REQUESTS ────────────────────────────────────────────────
    match /visit_share_requests/{id} {
      allow read: if approved()
        && (resource.data.fromUid == request.auth.uid
            || resource.data.toUid == request.auth.uid);

      allow create: if approved()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == 'pending';

      // Only the recipient accepts or rejects.
      allow update: if approved()
        && resource.data.toUid == request.auth.uid
        && request.resource.data.status in ['accepted', 'rejected'];

      allow delete: if isAdmin();
    }

    // ── RETAILER INDENTS ────────────────────────────────────────────────────
    match /retailer_indents/{id} {
      allow read: if approved();
      allow create: if approved()
        && request.resource.data.status == 'requested'
        && request.resource.data.requestedBy == request.auth.uid;
      // Fulfil / partial / cancel is an admin action in the Network tab.
      allow update, delete: if isAdmin();
    }

    // ── DISPATCHES & STOCK MOVEMENTS — append-only audit trail ──────────────
    match /dispatches/{id} {
      allow read: if approved();
      allow create: if isAdmin();
      allow update: if false;
      allow delete: if isSuperAdmin();   // Danger Zone only
    }

    match /stock_movements/{id} {
      allow read: if approved();
      allow create: if isAdmin();
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // ── LEGACY CREDITS (written on dispatch, read by nothing) ───────────────
    match /credits/{id} {
      allow read: if approved();
      allow create: if isAdmin();
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // ── LEAVE ───────────────────────────────────────────────────────────────
    match /leave_records/{id} {
      allow read: if isAdmin() || resource.data.uid == request.auth.uid;

      // Self-request (pending_approval), or admin marking on someone's behalf.
      allow create: if isAdmin()
        || (approved()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.status == 'pending_approval');

      // A user may only move their own ACTIVE leave to unmark_requested.
      // Approving, rejecting and removing are admin-only transitions.
      allow update: if isAdmin()
        || (approved()
            && resource.data.uid == request.auth.uid
            && resource.data.status == 'active'
            && request.resource.data.status == 'unmark_requested');

      allow delete: if isAdmin();
    }

    match /holidays/{id} {
      allow read: if approved();
      allow write: if isAdmin();
    }

    // ── EXPENSES ────────────────────────────────────────────────────────────
    match /expense_config/{id} {
      allow read: if approved();
      allow write: if isAdmin();
    }

    match /expense_reports/{id} {
      allow read: if isAdmin() || resource.data.userId == request.auth.uid;

      allow create: if approved()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'draft';

      // Owner may edit while draft or rejected — a submitted report is frozen
      // until an admin clears or rejects it.
      allow update: if isAdmin()
        || (approved()
            && resource.data.userId == request.auth.uid
            && resource.data.status in ['draft', 'rejected']);

      allow delete: if isAdmin();
    }

    match /expense_entries/{id} {
      allow read: if isAdmin() || resource.data.userId == request.auth.uid;
      allow create: if approved()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.amount >= 0;
      allow update, delete: if isAdmin()
        || (approved() && resource.data.userId == request.auth.uid);
    }

    // ── ALERTS ──────────────────────────────────────────────────────────────
    // READ SCOPING: NotificationBell.tsx:17 subscribes to the entire collection
    // and filters recipients in JavaScript, so per-recipient rules would break
    // it. To tighten: split into three queries (toUid == me / toRole ==
    // 'admin_group' / broadcast) and then restrict here.
    match /alerts/{id} {
      allow read: if approved();
      allow create: if approved();
      allow update: if approved() && onlyChanged(['read']);
      allow delete: if isAdmin();
    }

    // ── WORKSPACE — admin only ──────────────────────────────────────────────
    match /reminders/{id}        { allow read, write: if isAdmin(); }
    match /checklist_items/{id}  { allow read, write: if isAdmin(); }
    match /pinned_notes/{id}     { allow read, write: if isAdmin(); }

    // ── MARKETING ───────────────────────────────────────────────────────────
    match /post_statuses/{id} {
      allow read: if approved();
      allow write: if isAdmin() || isMarketing();
    }

    // ── LEGACY / UNUSED (still subscribed to by the UI) ─────────────────────
    match /checkins/{id} {
      allow read: if approved();
      allow create, update: if approved();
      allow delete: if isAdmin();
    }

    // StockManager.tsx:90 still subscribes to this even though nothing writes it.
    match /monthly_requests/{id} {
      allow read: if approved();
      allow write: if isAdmin();
    }

    // ── DEFAULT DENY ────────────────────────────────────────────────────────
    // Any collection not named above is inaccessible.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
