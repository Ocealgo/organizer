rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Ocealgo Team Dashboard — Firestore security rules
//
// DESIGN PRINCIPLE
//   Writes are locked down; reads stay as permissive as the current UI needs.
//   Every screen today subscribes to whole collections (`onSnapshot(collection(...))`)
//   and filters client-side, so tightening reads requires UI changes first —
//   see "READ SCOPING" notes below. Writes are where the real damage lives
//   (privilege escalation, unauthorised money movement), so that is what this
//   pass closes.
//
// ROLES
//   super_admin / admin  — implicitly hold every permission
//   sales_manager        — holds ONLY what users/{uid}.permissions grants
//   everyone else        — hold none
//   hasPerm() below mirrors can() in src/auth/permissions.ts. If you add a
//   permission in one place, add it in the other, or the UI toggle is cosmetic.
//
// KNOWN GAPS — deliberate, marked inline as [GAP n]. Read these before deploying.
//
// PERFORMANCE NOTE
//   approved()/isAdmin()/hasPerm() each do a get() on users/{uid}, which is a
//   billed read per rule evaluation. Once Cloud Functions exist, move role and
//   permissions onto custom auth claims and read request.auth.token instead.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Identity helpers ────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    // ── ATTENDANCE SWEEP MARKERS ────────────────────────────────────────────
    // One document per day recording which stages of the missed-punch-in sweep
    // have already fired, so a warning is sent once rather than every five
    // minutes. Written only by the scheduled function, which runs with admin
    // credentials and does not consult these rules. Nothing on a client has any
    // business reading or writing it.
    // A super admin may read and clear them, which is what "Run it again
    // today" in Settings does — without that, trying the sweep out means
    // waiting until tomorrow, because every stage is claimed for the day.
    // Nobody else has any business here.
    match /attendance_runs/{date} {
      allow read, delete: if isSuperAdmin();
      allow create, update: if false;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function approved() {
      return userExists() && userData().status == 'approved';
    }

    function isAdmin() {
      return approved() && userData().role in ['admin', 'super_admin'];
    }

    function isSuperAdmin() {
      return approved() && userData().role == 'super_admin';
    }

    function isSales() {
      return approved() && userData().role in ['offline_sales', 'online_sales'];
    }

    function isSalesManager() {
      return approved() && userData().role == 'sales_manager';
    }

    /**
     * The role on somebody else's account.
     *
     * Needed because who may clear a claim depends on whose claim it is, not
     * only on who is asking. A sales manager clears the officers they
     * supervise; their own claims, and their peers', belong to an admin.
     */
    function roleOf(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    /**
     * May the caller action a claim or a leave record belonging to `ownerUid`?
     *
     * Two things are refused here that a permission alone would allow. Nobody
     * signs off their own — a sales manager working in the field files the
     * same expenses they hold the power to clear, and that is the whole hole.
     * And nobody signs off a peer at their own level, so managers cannot
     * quietly clear each other. Both land on an admin instead.
     */
    function maySignOffFor(ownerUid, perm) {
      return isAdmin()
        || (hasPerm(perm)
            && ownerUid != request.auth.uid
            && !(roleOf(ownerUid) in ['sales_manager', 'admin', 'super_admin']));
    }

    function isMarketing() {
      return approved() && userData().role in ['offline_marketing', 'online_marketing'];
    }

    // ── Permission check ────────────────────────────────────────────────────
    function hasPerm(p) {
      return isAdmin()
        || (isSalesManager() && userData().get('permissions', {}).get(p, false) == true);
    }

    // ── Field-diff helpers ──────────────────────────────────────────────────
    // NOTE: affectedKeys() reports TOP-LEVEL keys only. An update to
    // `productStock.abc.locked` shows up as `productStock`. That limitation is
    // the root of [GAP 2].
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function onlyChanged(fields) {
      return changedKeys().hasOnly(fields);
    }

    function isUnchanged(field) {
      return !changedKeys().hasAny([field]);
    }

    // ── USERS ───────────────────────────────────────────────────────────────
    // The single most important block in this file: it is what stops any
    // logged-in employee from making themselves super_admin — and what stops a
    // sales_manager from widening their own permissions.
    match /users/{uid} {

      allow read: if isSelf(uid) || approved();

      // Signup. Self only, always pending, never a privileged role, and the
      // email must match the verified auth token so it cannot be spoofed.
      // This intentionally BLOCKS the hardcoded super-admin grant in
      // SignupPage.tsx — bootstrapping is a manual console action.
      allow create: if isSelf(uid)
        && request.resource.data.status == 'pending'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in [
             'offline_sales', 'online_sales',
             'offline_marketing', 'online_marketing'
           ];

      // Self-service: display name and mobile number. Never role, status or
      // permissions.
      //
      // The number is pinned to the one on the auth token, which Firebase only
      // puts there after an SMS code has actually been confirmed. So this
      // cannot be used to claim a colleague's number, or to write a number
      // nobody has proved they hold — the document is forced to agree with
      // what was verified rather than merely being checked by the form that
      // submitted it.
      // mustChangePassword may only ever be cleared here, never set. A manager
      // resets a password through a function that writes it with admin rights;
      // letting a client raise it would let anyone lock a colleague out of
      // their own account behind a password-change screen.
      allow update: if isSelf(uid)
        && onlyChanged(['name', 'phone', 'mustChangePassword'])
        && (isUnchanged('phone')
            || request.resource.data.phone == request.auth.token.phone_number)
        && (isUnchanged('mustChangePassword')
            || request.resource.data.mustChangePassword == false);

      // Admin: approve / reject / deactivate / change role / tune permissions.
      //   · a super_admin's doc is untouchable by anyone
      //   · an ADMIN's doc is touchable only by a super_admin. An admin who can
      //     deactivate their peers can remove everyone who might undo it, so
      //     that authority stops one level up rather than being held by every
      //     account that also holds it over them.
      //   · only a super_admin may grant super_admin
      allow update: if isAdmin()
        && resource.data.role != 'super_admin'
        && (resource.data.role != 'admin' || isSuperAdmin())
        && onlyChanged(['role', 'status', 'permissions',
                        'approvedAt', 'approvedBy', 'approvedByName'])
        && (request.resource.data.role != 'super_admin' || isSuperAdmin());

      // Sales manager with approve_sales_users: may action a PENDING signup
      // only, only into offline_sales, and never their own account.
      // 'permissions' is deliberately absent from the allowed key list, so a
      // manager can never widen anyone's access — including their own.
      allow update: if hasPerm('approve_sales_users')
        && !isAdmin()
        && !isSelf(uid)
        && resource.data.status == 'pending'
        && onlyChanged(['role', 'status',
                        'approvedAt', 'approvedBy', 'approvedByName'])
        && request.resource.data.status in ['approved', 'rejected']
        && (request.resource.data.status != 'approved'
            || request.resource.data.role == 'offline_sales');

      allow delete: if isSuperAdmin() && resource.data.role != 'super_admin';
    }

    // ── PARTIES ─────────────────────────────────────────────────────────────
    match /parties/{partyId} {
      allow read: if approved();

      allow create: if approved()
        && request.resource.data.status == 'prospect'
        && request.resource.data.addedBy == request.auth.uid;

      // Reps legitimately update parties: status → active on order, stock.*
      // on a revisit stock update, coordinates on a first visit, and inline
      // field edits. They may not touch the price they are charged — that is
      // an admin's to set, and no screen outside admin offers the field.
      allow update: if approved()
        && (isAdmin() || isUnchanged('pricePerPacket'));

      allow delete: if hasPerm('delete_parties');
    }

    // ── PRODUCTS ────────────────────────────────────────────────────────────
    // [GAP 1] seedDefaultProducts() in App.tsx is gated to admins in code —
    // if you ungate it, non-admins will hit permission errors here.
    match /products/{productId} {
      allow read: if approved();
      allow write: if hasPerm('manage_products');
    }

    // ── CONFIG ──────────────────────────────────────────────────────────────
    match /config/settings {
      allow read: if approved();
      allow write: if isSuperAdmin();   // Settings screen is super-admin only
    }

    match /config/stock {
      allow read: if approved();
      allow write: if hasPerm('edit_stock');

      // [GAP 2] Creating an allocation locks company stock, and reps and
      // managers both create allocations. Because affectedKeys() only sees
      // top-level keys, this also lets them alter productStock.*.total —
      // rules cannot express a nested-key restriction.
      //   Residual risk: stock totals can be inflated by a non-admin.
      //   Proper fix: move stock locking into a Cloud Function, then delete
      //   this rule so config/stock is permission-gated only.
      // Carton size and the legacy global pool stay protected either way.
      allow update: if (isSales() || isSalesManager())
        && onlyChanged(['productStock', 'updatedAt']);
    }

    // ── ALLOCATIONS (allocations_v2) — the money collection ─────────────────
    match /allocations_v2/{allocId} {
      allow read: if approved();

      allow create: if approved()
        && request.resource.data.status == 'pending'
        && request.resource.data.createdBy == request.auth.uid
        && !('paidAmount' in request.resource.data)
        && !('paidAt' in request.resource.data)
        && !('sentAt' in request.resource.data)
        && request.resource.data.packets > 0
        && request.resource.data.totalAmount >=
             request.resource.data.packets * request.resource.data.pricePerPacket - 1
        && request.resource.data.totalAmount <=
             request.resource.data.packets * request.resource.data.pricePerPacket + 1;

      allow update: if isAdmin();

      // Dispatching and cancelling is its own permission…
      allow update: if hasPerm('dispatch_allocations')
        && request.resource.data.status in ['sent', 'cancelled'];

      // …and settling is another. A manager can hold one without the other.
      allow update: if hasPerm('mark_paid')
        && request.resource.data.status == 'paid';

      // Author may edit or cancel their OWN still-pending allocation.
      allow update: if approved()
        && resource.data.createdBy == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status in ['pending', 'cancelled']
        && isUnchanged('createdBy')
        && isUnchanged('paidAmount')
        && isUnchanged('sentAt')
        && isUnchanged('paidAt');

      // [GAP 3] COMPATIBILITY RULE — REMOVE WHEN PAYMENTS MOVE SERVER-SIDE.
      //
      // RevisitLogger.tsx has reps apply collected payments FIFO, writing
      // paidAmount (and status → 'paid') directly onto SENT allocations.
      // That is a rep writing to the financial ledger.
      //
      // Enabled so deploying these rules does not break a live daily feature.
      // Once payment application is a callable Cloud Function, delete this
      // block — the strict rules above are already correct without it.
      allow update: if isSales()
        && resource.data.status in ['sent', 'overdue']
        && resource.data.paymentType == 'credit'
        && onlyChanged(['paidAmount', 'status', 'paidAt'])
        && request.resource.data.status in ['sent', 'overdue', 'paid'];

      allow delete: if isAdmin();
    }

    // ── PAYMENT TRANSACTIONS ────────────────────────────────────────────────
    match /payment_transactions/{txnId} {
      allow read: if approved();

      allow create: if approved()
        && request.resource.data.amount > 0
        && (
             hasPerm('approve_payments')
             || (request.resource.data.status == 'pending_approval'
                 && request.resource.data.collectedBy == request.auth.uid
                 && !('confirmedAt' in request.resource.data))
           );

      allow update: if hasPerm('approve_payments');

      allow delete: if isAdmin()
        || (approved()
            && resource.data.collectedBy == request.auth.uid
            && !('confirmedAt' in resource.data));
    }

    // ── VISIT LOGS ──────────────────────────────────────────────────────────
    match /visit_logs/{logId} {
      allow read: if isAdmin()
        || hasPerm('view_reports')
        || resource.data.salesPersonId == request.auth.uid
        || request.auth.uid in resource.data.get('sharedWith', []);

      allow create: if approved()
        && request.resource.data.salesPersonId == request.auth.uid;

      allow update: if isAdmin()
        || resource.data.salesPersonId == request.auth.uid
        || request.auth.uid in resource.data.get('sharedWith', [])
        || request.auth.uid in request.resource.data.get('sharedWith', []);

      allow delete: if isAdmin()
        || resource.data.salesPersonId == request.auth.uid;
    }

    // ── REVISIT LOGS ────────────────────────────────────────────────────────
    // READ SCOPING: VisitLogger queries `salesPersonId in [self, ...partners]`,
    // which a self-only rule cannot satisfy. Left readable to approved users
    // until visibility is driven by an explicit shared-with field on the doc.
    match /revisit_logs/{id} {
      allow read: if approved();
      allow create: if approved()
        && request.resource.data.salesPersonId == request.auth.uid;
      allow update, delete: if isAdmin()
        || resource.data.salesPersonId == request.auth.uid;
    }

    // ── VISIT SHARE REQUESTS ────────────────────────────────────────────────
    match /visit_share_requests/{id} {
      // The admin branch has to come first and stand alone. Firestore checks a
      // list query against the rule rather than against each document, so a
      // condition that only ever compares a field to the caller's own uid makes
      // any query for somebody else's rows unanswerable — not filtered, denied.
      // Without this an admin cannot ask "what has this person shared", which
      // is exactly what the reset survey asks.
      allow read: if isAdmin()
        || (approved()
            && (resource.data.fromUid == request.auth.uid
                || resource.data.toUid == request.auth.uid));

      allow create: if approved()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == 'pending';

      allow update: if approved()
        && resource.data.toUid == request.auth.uid
        && request.resource.data.status in ['accepted', 'rejected'];

      allow delete: if isAdmin();
    }

    // ── RETAILER INDENTS ────────────────────────────────────────────────────
    match /retailer_indents/{id} {
      allow read: if approved();
      allow create: if approved()
        && request.resource.data.status == 'requested'
        && request.resource.data.requestedBy == request.auth.uid;
      allow update, delete: if hasPerm('dispatch_allocations');
    }

    // ── DISPATCHES & STOCK MOVEMENTS — append-only audit trail ──────────────
    match /dispatches/{id} {
      allow read: if approved();
      allow create: if hasPerm('dispatch_allocations');
      allow update: if false;
      allow delete: if isSuperAdmin();   // Danger Zone only
    }

    match /stock_movements/{id} {
      allow read: if approved();
      allow create: if hasPerm('dispatch_allocations');
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // ── LEGACY CREDITS (written on dispatch, read by nothing) ───────────────
    match /credits/{id} {
      allow read: if approved();
      allow create: if hasPerm('dispatch_allocations');
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // ── LEAVE ───────────────────────────────────────────────────────────────
    match /leave_records/{id} {
      // view_reports is included because SalesReport queries by date range
      // across the whole team, with no uid filter to satisfy a self-only rule.
      allow read: if isAdmin()
        || hasPerm('view_leave')
        || hasPerm('view_reports')
        || resource.data.uid == request.auth.uid;

      allow create: if maySignOffFor(request.resource.data.uid, 'approve_leave')
        || (approved()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.status == 'pending_approval');

      // A user may only move their own ACTIVE leave to unmark_requested.
      // Approving, rejecting and removing are permission-gated — and never by
      // the person taking the leave, however many permissions they hold.
      allow update: if maySignOffFor(resource.data.uid, 'approve_leave')
        || (approved()
            && resource.data.uid == request.auth.uid
            && resource.data.status == 'active'
            && request.resource.data.status == 'unmark_requested');

      allow delete: if isAdmin();
    }

    match /holidays/{id} {
      allow read: if approved();
      allow write: if hasPerm('approve_leave');
    }

    // ── EXPENSES ────────────────────────────────────────────────────────────
    // The allowance rates and the ₹/km fuel rate. Setting them is a money
    // decision, so it rides on the same permission as clearing a report rather
    // than on being an admin — a sales manager who signs off expenses is the
    // person who sets what they are worth. The screen was already visible to
    // them; before this the save simply failed.
    match /expense_config/{id} {
      allow read: if approved();
      allow write: if hasPerm('clear_expenses');
    }

    match /expense_reports/{id} {
      allow read: if isAdmin()
        || hasPerm('view_expenses')
        || hasPerm('view_reports')
        || resource.data.userId == request.auth.uid;

      allow create: if approved()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'draft';

      // Owner may edit while draft or rejected — a submitted report is frozen
      // until someone who is allowed to sign off for THAT owner clears or
      // rejects it. Holding clear_expenses is not enough on its own: a manager
      // in the field files the same claims they can clear, so their own go to
      // an admin like everybody else's above officer level.
      allow update: if maySignOffFor(resource.data.userId, 'clear_expenses')
        || (approved()
            && resource.data.userId == request.auth.uid
            && resource.data.status in ['draft', 'rejected']);

      allow delete: if isAdmin();
    }

    match /expense_entries/{id} {
      allow read: if isAdmin()
        || hasPerm('view_expenses')
        || hasPerm('view_reports')
        || resource.data.userId == request.auth.uid;

      allow create: if approved()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.amount >= 0;

      allow update, delete: if isAdmin()
        || (approved() && resource.data.userId == request.auth.uid);
    }

    // ═════════════════════════════════════════════════════════════════════════
    // SALES OFFICER FIELD APP
    // Field records are evidence. An officer writes their own and closes them;
    // once closed only an admin may touch them, because the value of a punch-out
    // time or an odometer reading is that it cannot be revised afterwards.
    // ═════════════════════════════════════════════════════════════════════════

    // ── DUTY SESSIONS ───────────────────────────────────────────────────────
    match /duty_sessions/{id} {
      allow read: if isAdmin()
        || hasPerm('view_reports')
        || resource.data.uid == request.auth.uid;

      // A reading and its photo are required only when the officer says the
      // meter can be read. Broken meters and officers without a vehicle record
      // a reason instead, so the gap is explained rather than simply missing.
      allow create: if approved()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'active'
        && !('endOdometerKm' in request.resource.data)
        && (
             request.resource.data.get('odometerStatus', 'recorded') != 'recorded'
               ? request.resource.data.odometerIssueNote is string
               : (request.resource.data.startOdometerKm >= 0
                  && request.resource.data.startOdometerPhoto is string)
           );

      // The officer may only close their own open session. The start reading,
      // its photo and the start time can never be rewritten.
      allow update: if approved()
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'active'
        && isUnchanged('uid')
        && isUnchanged('startAt')
        && isUnchanged('startOdometerKm')
        && isUnchanged('startOdometerPhoto');

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── LOCATION TRACE ──────────────────────────────────────────────────────
    // High volume and append-only. Deletion is a retention job, not a user action.
    match /location_pings/{id} {
      allow read: if isAdmin()
        || hasPerm('view_reports')
        || resource.data.uid == request.auth.uid;
      allow create: if approved()
        && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // ── OUTLET VISITS ───────────────────────────────────────────────────────
    match /outlet_visits/{id} {
      allow read: if isAdmin()
        || hasPerm('view_reports')
        || resource.data.uid == request.auth.uid;

      allow create: if approved()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'open'
        && !('punchOutAt' in request.resource.data);

      // Execution and punch-out, by the officer, while the visit is still open.
      allow update: if approved()
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'open'
        && isUnchanged('uid')
        && isUnchanged('partyId')
        && isUnchanged('punchInAt')
        && isUnchanged('punchInLocation');

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── PASSWORD RESET REQUESTS ─────────────────────────────────────────────
    // Raised by somebody who cannot sign in, so it is written by a callable
    // function with admin credentials and never by a client — there is no
    // authenticated caller to check, and a public write path into this
    // collection would be a way to fill somebody's queue with noise.
    //
    // Closed the same way: the request is answered by the reset actually
    // happening, inside the same function, rather than by anybody ticking it
    // off. A queue that can be marked done without the work being done is
    // worse than no queue.
    match /password_requests/{id} {
      allow read: if isAdmin() || hasPerm('view_users');
      allow write: if false;
    }

    // ── PUSH TOKENS ─────────────────────────────────────────────────────────
    // One document per device that has agreed to receive notifications, keyed
    // by the token so re-registering the same handset overwrites instead of
    // piling up. Deliberately its own collection rather than a field on the
    // user: that block is the most security-sensitive in this file, and
    // "a device said hello" has no business loosening it.
    //
    // Nobody reads these from the client. Only the sending function needs
    // them, and it runs with admin credentials — so a rep cannot enumerate
    // which of their colleagues have notifications switched on.
    match /push_tokens/{token} {
      allow read: if false;

      allow create, update: if approved()
        && request.resource.data.uid == request.auth.uid;

      // Turning them off on your own device, or an admin clearing a stale one.
      allow delete: if isAdmin()
        || (approved() && resource.data.uid == request.auth.uid);
    }

    // ── REMOTE CONTACTS ─────────────────────────────────────────────────────
    // A shop reached by phone or message rather than by going to it. No
    // location, no punch in and out, and nothing to evidence it beyond the
    // rep's own word — which is exactly why it is kept in its own collection
    // and never counted as a visit.
    //
    // Written once and left alone. A conversation does not get amended after
    // the fact; a second conversation is a second record.
    match /remote_contacts/{id} {
      allow read: if isAdmin()
        || hasPerm('view_reports')
        || resource.data.uid == request.auth.uid;

      allow create: if approved()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.outcomeCategory is string
        && request.resource.data.partyId is string;

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── STOCK LEDGER ────────────────────────────────────────────────────────
    // Append-only by design. A ledger you can edit is not a ledger — a
    // correction is another line, not a rewrite of an old one.
    match /stock_ledger/{id} {
      allow read: if approved();
      allow create: if approved()
        && request.resource.data.byUid == request.auth.uid
        && request.resource.data.delta is number
        && request.resource.data.partyId is string
        && request.resource.data.productId is string;
      allow update: if false;
      allow delete: if isSuperAdmin();
    }


    // ── WORK PLANNING ───────────────────────────────────────────────────────
    // A beat is a named area and the shops in it. A plan is one person's day.
    // Neither blocks anything a rep does — the plan is what was intended, the
    // visits are what happened, and the comparison is drawn at read time.
    match /sales_routes/{id} {
      allow read: if approved();
      allow write: if hasPerm('assign_work');
    }

    match /work_plans/{id} {
      // The first three branches stand alone on purpose. Firestore checks a
      // list query against the rule rather than each document, so a manager
      // asking for "everyone, this week" needs a branch that does not mention
      // resource.data — otherwise the query is denied outright rather than
      // filtered, which is exactly how the share-requests read broke.
      allow read: if isAdmin()
        || hasPerm('assign_work')
        || hasPerm('view_reports')
        || resource.data.uid == request.auth.uid;

      // Reps never write their own plan. A day a rep could assign themselves
      // is not a plan, it is a diary.
      allow write: if hasPerm('assign_work');
    }

    // ── WHAT A MANAGER DID ──────────────────────────────────────────────────
    // Meetings, days out with a rep, days at the desk — the parts of a
    // manager's day nothing else records.
    match /manager_activities/{id} {
      // The admin branch stands alone so "everybody, this month" is answerable;
      // the second matches a manager listing their own with a uid filter. A rep
      // sees none of it.
      allow read: if isAdmin()
        || resource.data.uid == request.auth.uid;

      // Only ever about yourself, and only a manager has this kind of day.
      allow create: if isSalesManager()
        && request.resource.data.uid == request.auth.uid;

      // Their own entries, theirs to correct. A same-day-only rule was the
      // first instinct, but expressing "today" here means timestamp arithmetic
      // that compiles happily and can still deny at runtime — a brittle guard
      // on a log whose value is that it exists at all, not that it cannot be
      // revised. `updatedAt` records that it changed, and an admin sees it.
      allow update, delete: if isAdmin()
        || (isSalesManager() && resource.data.uid == request.auth.uid);
    }

    // ── ALERTS ──────────────────────────────────────────────────────────────
    // READ SCOPING: NotificationBell subscribes to the entire collection and
    // filters recipients in JavaScript, so per-recipient rules would break it.
    // To tighten: split into three queries (toUid == me / toRole ==
    // 'admin_group' / broadcast) and then restrict here.
    match /alerts/{id} {
      allow read: if approved();
      allow create: if approved();
      allow update: if approved() && onlyChanged(['read']);
      allow delete: if isAdmin();
    }

    // ── WORKSPACE ───────────────────────────────────────────────────────────
    match /reminders/{id}        { allow read, write: if hasPerm('view_workspace'); }
    match /checklist_items/{id}  { allow read, write: if hasPerm('view_workspace'); }
    match /pinned_notes/{id}     { allow read, write: if hasPerm('view_workspace'); }

    // ── MARKETING ───────────────────────────────────────────────────────────
    match /post_statuses/{id} {
      allow read: if approved();
      allow write: if isAdmin() || isMarketing();
    }

    // ── LEGACY / UNUSED (still subscribed to by the UI) ─────────────────────
    match /checkins/{id} {
      allow read: if approved();
      allow create, update: if approved();
      allow delete: if isAdmin();
    }

    match /monthly_requests/{id} {
      allow read: if approved();
      allow write: if isAdmin();
    }

    // ── DEFAULT DENY ────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
