# `npm run sandbox` only. The same emulator project as .env.test, plus the
# sandbox's own tools (the "pretend today is" switch). e2e runs use .env.test
# and never see them; a live build has neither file.
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-ocealgo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-ocealgo
VITE_FIREBASE_STORAGE_BUCKET=demo-ocealgo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demoapp
VITE_USE_EMULATORS=true
VITE_SANDBOX=true
